<Project Sdk="Microsoft.NET.Sdk">

  <!-- The services module's own tests (architecture.md Sec 15.1: module
       tests travel with the module, under the module's tests directory).
       They reference the module assembly and the contract project only:
       no kernel test reach and no loader involvement, since the
       registration path itself is pinned by the integration suites'
       in-tree loading test. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rod.Modules.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
