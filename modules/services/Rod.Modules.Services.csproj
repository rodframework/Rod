<Project Sdk="Microsoft.NET.Sdk">

  <!-- The server-side half of the services module (architecture.md
       Sec 15.1). It lives outside src/teamserver because it is
       module-layer work, not kernel work: nothing under src/teamserver
       references it (the architecture tests enforce that), and the
       teamserver loads it exactly the way it loads an operator's
       external module, namely an assembly beside the binary plus an
       entry under Capabilities:Modules. The only in-house reference a
       server module may carry is the contract project itself. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\teamserver\Rod.Capabilities\Rod.Capabilities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The module's tests are their own project under tests/ (the module
         lane's discovery shape); the assembly glob must not swallow them. -->
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>

</Project>
