{
  // QUICKSTART -- everything to decide before the first start, in four lines.
  // Every other section below has a working default and carries its own detail
  // where it applies; the full table lives in docs/operations/teamserver.md
  // (Configuration reference).
  //
  //   1. Operator front: the Listeners section is pre-set to one loopback
  //      HTTP socket (127.0.0.1:59443) serving the UI and API. Implant
  //      listeners are NOT configured here -- create them per engagement in
  //      the Listeners panel.
  //   2. First login: set Operators__Initial__Handle / __Password through
  //      the environment (no inline secrets; the display name derives from
  //      the handle). Unset, both environments seed an admin handle "admin" --
  //      password "admin" in Development, or in Production a generated
  //      password logged exactly once at first boot.
  //   3. Durability: the audit trail, task artifacts, and built payloads
  //      always persist to Audit:DataDirectory below. Core state
  //      (engagements, implants, tasks, tokens, listeners) survives a restart
  //      only with ConnectionStrings:Postgres set -- production wants it.
  //   4. Done: dotnet run --project src/teamserver/Rod.TeamServer

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Production implant CA (architecture.md Sec 9): an externally provisioned
  // engagement CA consumed as PEM files. Supply both paths to replace the
  // walking-skeleton self-signed DevCertificateAuthority so enrollment binds
  // certificates to the operator's CA chain; omit the section to keep the dev
  // CA. CaPrivateKeyPassphrase decrypts an encrypted PKCS#8 key -- set it via
  // an environment variable (Pki__CaPrivateKeyPassphrase) or a secret store,
  // never inline here. See ADR 0010.
  //
  // "Pki": {
  //   "CaCertificatePath": "/etc/rod/pki/ca.crt",
  //   "CaPrivateKeyPath": "/etc/rod/pki/ca.key",
  //   "CaPrivateKeyPassphrase": ""
  // },

  // The redirector control plane (architecture.md Sec 8): redirectors enroll
  // as managed nodes and dial home over the control channel, which rides the
  // shared tier below (the operator front or any deliberately shared
  // ingress -- never an engagement's implant listener). One knob: the
  // upstream face pushed rules name, for deployments whose listener bind
  // hosts are not dialable from the fleet (NAT, container bridges). Absent
  // it, a rule names the listener's own bind host, falling back to the local
  // address the node's control connection proved reachable for wildcard
  // binds.
  //
  // "Redirectors": {
  //   "AdvertisedUpstreamHost": "10.0.0.5"
  // },

  // The shared listener tier (architecture.md Sec 8): the operator front the
  // UI and API ride, plus any deliberately shared ingress a deployment fronts
  // (the certificate-less enroll edge shape). Implant-facing listeners are
  // NOT configured here -- each belongs to one engagement, is created through
  // the operator API (Listeners panel), and is persisted so a restart rebinds
  // it; enrollment through a scoped listener accepts only that engagement's
  // tokens.
  "Listeners": [
    {
      "Name": "operator-http",
      "Transport": "Http",
      "BindAddress": "127.0.0.1:59443",
      "PublicEndpoint": "http://localhost:59443"
    }
  ],

  // Session staleness sweep (architecture.md Sec 10.3): a beacon stream that
  // dies silently -- no clean close, no more frames -- would otherwise leave its
  // session Active forever. The hosted sweeper closes any Active session whose
  // last-seen stamp is older than Threshold, which drops the implant off the
  // online roster; SweepInterval is how often the check runs. Both are TimeSpan
  // strings. Omit the section to keep the 15-minute / 1-minute defaults.
  // These are the boot defaults: the Settings page changes the live values at
  // runtime (no restart) and the RuntimeSettings file below remembers them.
  "Sessions": {
    "Staleness": {
      "Threshold": "00:15:00",
      "SweepInterval": "00:01:00"
    }
  },

  // Where the Settings page's runtime overrides persist (relative to the
  // working directory). The live values apply immediately on change; this file
  // is only how a restart remembers them. Empty or absent disables
  // persistence -- changes then live for the process lifetime alone.
  "RuntimeSettings": {
    "FilePath": "runtime-settings.json",
    // The build section (the shared cargo target dir) persists to its own
    // file beside the session pair, same best-effort posture.
    "BuildFilePath": "runtime-build-settings.json"
  },

  // Durable teamserver state (ADR 0003): when a Postgres
  // connection string is set here, the composition root swaps the in-memory
  // core-state and audit/artifact adapters for the Postgres-backed pair in
  // Rod.Persistence, so every engagement, operator, implant, session, task, and
  // token survives a restart and the audit chain still verifies. Uncomment and
  // point at a reachable database to opt in; otherwise the in-memory adapters
  // stay registered (state is lost on restart) and the file-backed audit trail
  // below is the durable stand-in.
  //
  // "ConnectionStrings": {
  //   "Postgres": "Host=localhost;Port=5432;Database=rod;Username=rod;Password=rod"
  // },

  // Post-operation retention: the engagement trail and its
  // artifacts persist to this directory, so they outlive a teamserver restart and
  // infrastructure teardown. The composition root swaps the in-memory audit and
  // artifact adapters for the file-backed pair when this is set. Remove the
  // section to fall back to in-memory (state is lost on restart).
  "Audit": {
    "DataDirectory": "./data/audit"
    // Optional (base64, 32 bytes recommended): when set, audit links are
    // HMAC-SHA256 under this key instead of bare SHA-256, so someone with
    // write access to the storage alone cannot rewrite a trail
    // consistently. Keep the key somewhere other than the store it
    // protects; the offline verifier takes it via --chain-key.
    // "ChainKey": "<base64>"
  },

  // Capability modules (architecture.md Sec 10.2, Sec 15.1): a list of
  // "Namespace.Type, AssemblyName" entries. Each listed type must implement
  // Rod.Capabilities.Modules.ICapabilityModule; the assembly is resolved by
  // name (already loaded, or a same-named dll next to the teamserver binary),
  // the type is instantiated at startup, and its descriptor replaces the
  // placeholder for its verb (last registration wins) -- adding a module is a
  // deploy-time config entry, never a composition-root edit. The in-tree
  // reference modules under modules/ are built and deployed beside the binary
  // by the build and load through this same list; an operator's external
  // module takes the identical path. A missing assembly or a non-module type
  // fails startup loudly rather than tasking into a placeholder.
  "Capabilities": {
    "Modules": [
      "Rod.Modules.Hostenum.HostEnumCapabilityModule, Rod.Modules.Hostenum",
      "Rod.Modules.Domainenum.DomainEnumCapabilityModule, Rod.Modules.Domainenum",
      "Rod.Modules.Runkeys.RunKeysCapabilityModule, Rod.Modules.Runkeys",
      "Rod.Modules.Services.ServicesCapabilityModule, Rod.Modules.Services",
      "Rod.Modules.Wmi.WmiCapabilityModule, Rod.Modules.Wmi",
      "Rod.Modules.Hijack.HijackCapabilityModule, Rod.Modules.Hijack",
      "Rod.Modules.Hives.HivesCapabilityModule, Rod.Modules.Hives"
    ],
    // Asset modules (architecture.md Sec 15.1): directories carrying a
    // rod-module.toml whose [[assets]] rows name the files the module
    // serves -- the browser hook script, phishing templates, any content
    // the teamserver renders or serves without executing. Entries are
    // paths relative to the teamserver binary; the build deploys the
    // in-tree set under modules/ beside the binary, and an operator's
    // external module takes the identical path. Nothing is servable until
    // its module is deployed and listed (the browser-hook mint answers
    // 503 naming this section), and a listed directory that is missing or
    // broken aborts startup.
    "AssetModules": [
      "modules/browserhook",
      "modules/lure-templates"
    ]
  },

  // Range mode (architecture.md Sec 15.3): the action domain's simulated
  // provider -- scripted beacons that enroll, contact, and answer tasking
  // through the real wire protocol against this process's own listeners.
  // Off by default; enabled, it mounts the /engagements/{id}/range surface
  // (spawn, status, stop) for engagements created with range: true. A range
  // fleet needs an http-family listener (the cleartext lab posture it
  // contacts under) and dials the listener's own bind -- the redirector hop
  // is the one leg it cannot exercise from inside the process.
  "Range": {
    "Enabled": false
  },

  // The build unit's source tree: an installed teamserver (a publish with no
  // repo above it) names the Rust crate the unit compiles at build-request
  // time; unset keeps the repo walk-up a checkout uses (teamserver.md, the
  // install section, names the minimal deployed tree).
  "Build": {
    // "RustSourceDirectory": "/opt/rod/src/src/implant/rust"
  },

  // The opt-in LLM triage client (architecture.md Sec 11): summarize a
  // completed task's captured output from the task read. Disabled by
  // default -- every request sends engagement content off-platform, so the
  // egress decision (which endpoint, cloud or local) is the operator's.
  // The wire contract is the OpenAI chat-completions shape: any compatible
  // endpoint serves it. Set the key through the environment
  // (Llm__ApiKey), never inline here. See docs/operations/llm.md before
  // enabling.
  //
  // "Llm": {
  //   "Enabled": true,
  //   "BaseUrl": "https://open.bigmodel.cn/api/paas/v4",
  //   "Model": "glm-5.3"
  // }

  // The external recon workbench's halves (architecture.md Sec 11.4):
  // RDAP, certificate-transparency, DoH, and whois lookups plus the
  // port scan, all run on the teamserver. Every half stays closed (its
  // route answers 503 naming this section) until its endpoint is named,
  // because naming an endpoint is the egress decision. See
  // docs/operations/recon.md before arming any half; the scan also
  // gates on the engagement's ROE target scope.
  //
  // "Recon": {
  //   "RdapBaseUrl": "https://rdap.org",
  //   "CtBaseUrl": "https://crt.sh",
  //   "DohBaseUrl": "https://cloudflare-dns.com/dns-query",
  //   "WhoisServer": "whois.iana.org",
  //   "ScanOrigin": "Teamserver"
  // }

  // The delivery campaign's send engine (architecture.md Sec 11.5): the
  // scan cadence and the per-message SMTP bound. Engine knobs only --
  // no relay is named here and none is defaulted, because which relay
  // sends a campaign's mail (and whose address it leaves from) is the
  // egress decision each campaign body makes and the runbook records.
  // See docs/operations/campaigns.md before launching one.
  //
  // "Campaigns": {
  //   "EngineTickSeconds": 5,
  //   "SendTimeoutSeconds": 20
  // }
}
