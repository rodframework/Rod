<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Rod.TeamServer is the runnable teamserver process (architecture.md Sec 4) and
    the composition root: it wires Rod.Transport's services and endpoints and
    serves the operator UI. It is not one of the six internal layers, and the
    layer dependency rules (tests/teamserver/Rod.Architecture.Tests) do not
    constrain it. As the composition root it references the layers it assembles:
    transport, plus the operator layer, whose SSE event stream and live bus are
    wired here (transport itself cannot reference Rod.Operators). It also
    references Rod.Capabilities, whose capability registry is wired here so the
    live task path resolves verbs through it (transport itself cannot reference
    Rod.Capabilities either), and Rod.Persistence, whose Postgres-backed adapters
    swap in for the in-memory ports when ConnectionStrings:Postgres is set
    (ADR 0003).
  -->
  <ItemGroup>
    <ProjectReference Include="..\Rod.Transport\Rod.Transport.csproj" />
    <ProjectReference Include="..\Rod.Operators\Rod.Operators.csproj" />
    <ProjectReference Include="..\Rod.Capabilities\Rod.Capabilities.csproj" />
    <ProjectReference Include="..\Rod.Persistence\Rod.Persistence.csproj" />
  </ItemGroup>

  <!-- EF Core design-time tools resolve against the startup project (AGENTS.md
       Sec 4: `dotnet ef migrations add ... -s <Web>`), so the host carries the
       Design package as a private asset. It is never deployed and never reaches
       the runtime dependency graph. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <!-- Release provenance: compile the BuildStamp (version + source commit)
         the startup log line and GET /build report (Directory.Build.targets).
         The implant and stager are deliberately NOT stamped: a captured
         artifact must not carry the teamserver's source provenance. -->
    <RodStampBuildInfo>true</RodStampBuildInfo>
  </PropertyGroup>

  <!-- The built operator UI is gitignored, so this project's build produces
       wwwroot/index.html with npm. The target is incremental in MSBuild's own
       terms: Inputs are the SPA's sources, Output the bundle, so it runs
       exactly when the bundle is missing or older than any source. The first
       build of a fresh clone, and every build after the sources moved (a
       pull, an edit) both refresh the frontend a plain `dotnet run` serves;
       nothing having changed costs no npm at all. npm is probed first so a
       backend-only checkout without Node still builds; the root route then
       answers with a plain explanation instead of a broken UI (Program.cs). -->
  <ItemGroup>
    <RodClientSources Include="Client/src/**/*.ts;Client/src/**/*.tsx;Client/src/**/*.css;Client/*.json;Client/*.ts;Client/*.html" />
  </ItemGroup>
  <Target Name="EnsureOperatorUiBundle" BeforeTargets="Build" Inputs="@(RodClientSources)" Outputs="wwwroot/index.html">
    <Exec Command="npm --version" IgnoreExitCode="true" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="_RodNpmProbe" />
    </Exec>
    <!-- npm ci restores node_modules only when it is absent: the frequent
         case (sources moved, deps installed) pays just the vite build. -->
    <Exec Condition="'$(_RodNpmProbe)' == '0' and !Exists('Client/node_modules')" Command="npm ci" WorkingDirectory="Client" ConsoleToMSBuild="true" />
    <Exec Condition="'$(_RodNpmProbe)' == '0'" Command="npm run build" WorkingDirectory="Client" ConsoleToMSBuild="true" />
    <Message Condition="'$(_RodNpmProbe)' != '0'" Importance="high" Text="Operator UI bundle not found (wwwroot/index.html) and npm is not on PATH; the server will run API-only. Build it with npm ci &amp;&amp; npm run build in src/teamserver/Rod.TeamServer/Client." />
  </Target>
</Project>
