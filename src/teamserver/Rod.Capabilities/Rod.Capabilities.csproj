<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Rod.CoreState\Rod.CoreState.csproj" />
  </ItemGroup>


  <!-- The capabilities layer exposes the operator-facing capability catalog
       endpoint (the UI surfaces every capability category as
       tasking, driven by the registry rather than a hardcoded verb table). It
       maps that endpoint itself for the same layer-separation reason the
       operator layer maps its SSE stream: transport cannot reference
       Rod.Capabilities (architecture test LayerDependencyTests), so the catalog
       endpoint is mapped from the composition root alongside MapOperatorEndpoints.
       The ASP.NET Core App framework reference also provides the DI abstractions
       the composition-root hook (AddRodCapabilities) registers the registry and
       resolver against, so no separate abstractions package is needed. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Tomlyn: the asset-module host reads the [module] name and [[assets]]
       rows out of a module directory's rod-module.toml (the manifest's full
       grammar stays the CLI's, architecture.md Sec 15.2). -->
  <ItemGroup>
    <PackageReference Include="Tomlyn" />
  </ItemGroup>

  <PropertyGroup>
  </PropertyGroup>

</Project>
