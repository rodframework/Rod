<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Rod.CoreState\Rod.CoreState.csproj" />
    <!-- Rod.Protocol is the language-neutral wire contract (architecture.md
         Sec.8/9); the transport layer speaks it, mapping enrollment and other
         outcomes to wire status codes. Protocol itself depends on nothing
         in-house, and still never leaks into core state. -->
    <ProjectReference Include="..\Rod.Protocol\Rod.Protocol.csproj" />
    <!-- Rod.Audit is the innermost ring alongside core state (architecture.md
         Sec 4.1/11). Transport composes the audit write when a task result
         arrives: it depends inward on the audit port, never the reverse. Audit
         still depends on nothing in-house. -->
    <ProjectReference Include="..\Rod.Audit\Rod.Audit.csproj" />
    <!-- Rod.BuildPipeline drives the external build units (architecture.md Sec 6).
         The operator-facing payload-build endpoint drives the
         build orchestrator and composes the PayloadBuilt audit write, so transport
         depends inward on the build contract. BuildPipeline still depends on core
         state only. -->
    <ProjectReference Include="..\Rod.BuildPipeline\Rod.BuildPipeline.csproj" />
  </ItemGroup>

  <!-- The transport layer terminates C2 endpoints and the operator API: it needs
       ASP.NET Core (Kestrel, routing, JSON). A FrameworkReference avoids a long
       list of PackageReferences and tracks the runtime version centrally. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- MailKit: the delivery campaign's SMTP sends (architecture.md Sec 11.5).
       The version is tracked centrally in Directory.Packages.props.
       System.Security.Cryptography.Pkcs rides MailKit transitively; the direct
       reference applies the centrally pinned patched version to that
       transitive (see Directory.Packages.props for the advisory). -->
  <ItemGroup>
    <PackageReference Include="MailKit" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <!-- The browser hook template is module-layer content (architecture.md
       Sec 15.1): it lives under modules/browserhook and reaches the mint
       through the asset-module seam at runtime, so the kernel embeds no
       script or template assets; the architecture tests hold that line. -->

  <!-- The DNS contact codec, name grammar, and bridge are internal transport
       machinery; the integration tests exercise them directly (the same
       same-package access pattern the reference implant grants its tests). -->
  <ItemGroup>
    <InternalsVisibleTo Include="Rod.Integration.Tests" />
  </ItemGroup>

</Project>
