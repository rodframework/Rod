<Project Sdk="Microsoft.NET.Sdk">

  <!-- The operator CLI (architecture.md Sec 15.3, ADR-002): the `rod mod`
       module-lifecycle suite. It references exactly one in-house project:
       Rod.Packaging, the packaging contract library holding the manifest
       grammar, the canonical form, the signing chain, the registry index,
       and the lock file. Every other coupling stays a file contract, so
       the CLI still builds and ships on its own, outside the layer
       matrix. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>rod</AssemblyName>
    <RootNamespace>Rod.Cli</RootNamespace>
    <RodStampBuildInfo>true</RodStampBuildInfo>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\teamserver\Rod.Packaging\Rod.Packaging.csproj" />
  </ItemGroup>

</Project>
