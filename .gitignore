# Curated to what this tree actually produces: .NET build output and test
# runs, the operator UI's node and bundle output, the teamserver's local
# data directory, and editor/OS noise.

# .NET build output and test runs
[Bb]in/
[Oo]bj/
artifacts/
[Tt]est[Rr]esult*/
coverage*.json
coverage*.xml
coverage*.info

# Operator UI: the Vite build output is produced by `npm run build` (CI does it
# before `dotnet build`); only the React sources under src/teamserver/Rod.TeamServer/Client
# are tracked, not the emitted wwwroot bundle.
src/teamserver/Rod.TeamServer/wwwroot/
node_modules/

# Runtime state the teamserver writes when Audit:DataDirectory points at a
# local directory (a dev-loop shape): the file-backed trail and blobs are
# per-install state, never source.
src/teamserver/Rod.TeamServer/data/

# Local configuration
.env

# Agent session state (tooling working directory, never source)
.zcode/

# Editor state
.vs/
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.user
*.suo
*.rsuser

# OS noise
.DS_Store
Thumbs.db
[Dd]esktop.ini

# Logs
*.log

# Docs site build output (mkdocs, docs-site.yml): the site renders the
# tracked files, and the derived home page (docs/index.md, from README.md)
# is a build artifact, never committed.
site/
docs/index.md
