<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The harness (rig, minimal implant, process candidate) lives in the
         conformance library; referencing the runner and example-implant
         executables flows their assemblies in so the end-to-end tests spawn
         them exactly as an author outside the tree would. -->
    <ProjectReference Include="..\..\..\src\conformance\dotnet\Rod.Conformance\Rod.Conformance.csproj" />
    <ProjectReference Include="..\..\..\src\conformance\dotnet\Rod.Conformance.Runner\Rod.Conformance.Runner.csproj" />
    <ProjectReference Include="..\..\..\src\conformance\dotnet\Rod.Conformance.Minimal\Rod.Conformance.Minimal.csproj" />
  </ItemGroup>

</Project>
