<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Live Postgres for the durability acceptance test (ADR 0003). An
         ephemeral container per test class; tests skip (not fail)
         when Docker is unavailable, so CI without Docker stays green. -->
    <PackageReference Include="Testcontainers.PostgreSql" />
    <!-- Direct reference forces the transitive SSH.NET (pulled by
         Testcontainers) up to the central version in Directory.Packages.props,
         above the vulnerable 2025.1.0 (GHSA-q939-rpr3-3284). -->
    <PackageReference Include="SSH.NET" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\teamserver\Rod.Transport\Rod.Transport.csproj" />
    <!-- Referenced so the operator layer (live bus + SSE endpoint) can be
         layered into the test host alongside the transport core. -->
    <ProjectReference Include="..\..\..\src\teamserver\Rod.Operators\Rod.Operators.csproj" />
    <!-- Referenced so the capabilities layer (capability registry wired onto
         the live task path) can be layered into the test host alongside the
         transport core. -->
    <ProjectReference Include="..\..\..\src\teamserver\Rod.Capabilities\Rod.Capabilities.csproj" />
    <!-- Referenced so the durable PostgreSQL store (Postgres-backed
         operators and engagements) can be layered into the test host and the
         durability acceptance test can resolve its DbContext directly. -->
    <ProjectReference Include="..\..\..\src\teamserver\Rod.Persistence\Rod.Persistence.csproj" />
    <!-- Referenced so the composition root's own surface is testable: the
         build-stamp endpoint (GET /build) lives in the executable because the
         stamp is a property of the binary, not of any layer. -->
    <ProjectReference Include="..\..\..\src\teamserver\Rod.TeamServer\Rod.TeamServer.csproj" />
    <!-- The in-tree reference module (modules/hostenum), so its assembly
         lands in the test bin directory: the stand-in for the deploy step
         (the teamserver build copying module dlls beside the binary). The
         in-tree module loading test resolves it through the config-listed
         loader path exactly as production does; no test code touches its
         types beyond that assertion. -->
    <ProjectReference Include="..\..\..\modules\hostenum\Rod.Modules.Hostenum.csproj" />
    <!-- The domain-discovery module (modules/domainenum) rides the same
         stand-in: its assembly lands beside the test host's, and the
         loading test exercises its config-listed entry the same way. -->
    <ProjectReference Include="..\..\..\modules\domainenum\Rod.Modules.Domainenum.csproj" />
  </ItemGroup>

</Project>
