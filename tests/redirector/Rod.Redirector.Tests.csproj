<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The xUnit unit tests for the in-tree reference redirector (ADR 0009/0011).
    The redirector ships in Rod.slnx, so this project does too and is built and
    tested centrally with the rest of the solution. The redirector's config
    parser, CIDR allow-list, and forwarding logic are internal; InternalsVisibleTo
    in Rod.Redirector.csproj exposes them here, the .NET equivalent of the
    implant's same-assembly test access.
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!--
      Directory.Build.props at the repo root already sets Nullable,
      TreatWarningsAsErrors, and the latest LangVersion repo-wide, and applies to
      this tree (it walks up from the project dir). CPM is on repo-wide and the
      test package versions are governed centrally by Directory.Packages.props.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <!-- References the redirector so the tests reach its internal config, CIDR
       allow-list, and forwarder types. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\redirector\Rod.Redirector.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
