         teamserver's descriptor loader enumerations (Rod.Capabilities); the
         enums cannot be shared without the contract library taking a kernel
         reference, so the closed sets stay pinned by this bridge. -->
    <ProjectReference Include="..\..\..\src\teamserver\Rod.Capabilities\Rod.Capabilities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

